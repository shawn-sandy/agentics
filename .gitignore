
# User-specific Claude Code configuration
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local artifacts inbox — the published copy lives in docs/artifacts/
.claude/artifacts/

# Claude Code local overrides
CLAUDE.local.md
.claude.md.local

# Node.js
# Unanchored on purpose: npm creates these at arbitrary depth and they are
# never publishable content.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Anchored: ignores root build output only. An unanchored `build/` matched any
# directory named build at any depth and silently swallowed
# kit/plugins/plan-agent/skills/build/. The marketplace publishes plugins via
# `git-subdir`, so for that path git IS the publish filter: a rule matching
# inside kit/plugins/ drops that path for everyone installing from GitHub, with
# no error anywhere. (build-dist walks the working tree instead, so it would
# still copy the file — the two published forms then disagree silently.)
# Guarded by tests/publish/test-no-ignored-plugin-files.sh.
/build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Test coverage
/coverage/
/.nyc_output/

# Logs
/logs/
*.log

# Temporary files
/tmp/
/temp/
*.tmp
The-Complete-Guide-to-Building-Skill-for-Claude.pdf
tests/sandbox/.gitkeep
/examples/

# Playwright MCP session files
.playwright-mcp/

# Social card smoke-test and preview artifacts
docs/media/social/*-smoke-test-*
docs/media/social/gap-preview-*

# Build output
/dist/

# Python bytecode from plugin hooks (generated when a hook runs).
# Unanchored on purpose: hooks run inside kit/plugins/, so this must match at
# any depth. Never publishable content.
__pycache__/
*.pyc
