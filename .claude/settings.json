{
    "permissions": {
        "allow": [
            "Bash(tree:*)",
            "Bash(git ls-files)"
        ]
    },
    "plansDirectory": "docs/plans",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq empty .claude-plugin/marketplace.json 2>&1 && echo 'OK: marketplace.json valid' || echo 'ERROR: marketplace.json has invalid JSON — fix before committing'"
                    }
                ]
            }
        ]
    }
}