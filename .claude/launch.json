{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "plans-gallery",
      "autoPort": true,
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "python3 -m http.server \"$PORT\" --bind 127.0.0.1 --directory docs/plans"]
    },
    {
      "name": "media-library",
      "autoPort": true,
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "python3 -m http.server \"$PORT\" --bind 127.0.0.1 --directory docs/media/social"]
    },
    {
      "name": "docs-all",
      "autoPort": true,
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "python3 -m http.server \"$PORT\" --bind 127.0.0.1 --directory docs"]
    }
  ]
}
